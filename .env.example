# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (see README → "Environment variables").

# Canonical URL used for metadata, sitemap and OG images (defaults to Vercel's production URL).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Terminal / Messages agent (/api/agent) ---
# Anthropic API key. Without it the agent answers with a "not switched on" message.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-haiku-4-5
AGENT_MODEL=
# Test-only: stream a canned reply without calling a model (used by Playwright).
AGENT_MOCK=

# --- Redis (rate limits + Activity Monitor stats) ---
# Added automatically by the Upstash for Redis integration on the Vercel Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ...or, for an Upstash database created directly:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contact form (/api/contact) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Where messages go. Defaults to the email in content/profile.json.
CONTACT_TO_EMAIL=

# --- Cloudflare Turnstile (spam protection for the contact form) ---
# Both keys are needed; without them the form relies on the honeypot and rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
